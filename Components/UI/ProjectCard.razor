<article class="@CardClass" aria-label="@($"{Title} - {Category}")">
    <div class="project-card__visual project-card__visual--@Preview" aria-hidden="true">
        <div class="project-card__window-bar">
            <span></span><span></span><span></span>
            <small>@PreviewLabel</small>
        </div>

        @if (Preview == "frontend")
        {
            <div class="project-card__operations-preview">
                <div class="project-card__preview-sidebar">
                    <i></i><i></i><i></i><i></i>
                </div>
                <div class="project-card__preview-content">
                    <div class="project-card__preview-heading"><span></span><i></i></div>
                    <div class="project-card__preview-kpis">
                        <div><small>Vues</small><strong>BI</strong></div>
                        <div><small>Exploration</small><strong>Filtres</strong></div>
                        <div><small>Détail</small><strong>Tables</strong></div>
                    </div>
                    <div class="project-card__preview-chart">
                        <span style="--bar-height: 44%"></span>
                        <span style="--bar-height: 62%"></span>
                        <span style="--bar-height: 54%"></span>
                        <span style="--bar-height: 78%"></span>
                        <span style="--bar-height: 68%"></span>
                        <span style="--bar-height: 88%"></span>
                    </div>
                </div>
            </div>
        }
        else if (Preview == "data")
        {
            <div class="project-card__flow-preview">
                <div class="project-card__flow-node"><i></i><span>ERP</span><small>Source de test</small></div>
                <div class="project-card__flow-line"><span></span></div>
                <div class="project-card__flow-node project-card__flow-node--active"><i></i><span>SSIS</span><small>Contrôles ETL</small></div>
                <div class="project-card__flow-line"><span></span></div>
                <div class="project-card__flow-node"><i></i><span>DWH</span><small>SQL Server</small></div>
            </div>
        }
        else
        {
            <div class="project-card__reporting-preview">
                <div class="project-card__reporting-summary">
                    <span>Chaîne automatisée</span>
                    <strong>CI/CD</strong>
                    <small>Tests · sécurité · déploiement</small>
                </div>
                <div class="project-card__reporting-bars">
                    <span style="--bar-height: 36%"></span>
                    <span style="--bar-height: 52%"></span>
                    <span style="--bar-height: 46%"></span>
                    <span style="--bar-height: 72%"></span>
                    <span style="--bar-height: 64%"></span>
                    <span style="--bar-height: 86%"></span>
                </div>
            </div>
        }
    </div>

    <div class="project-card__body">
        <div class="project-card__header">
            <span class="project-card__index">@Step</span>
            <span class="project-card__status">@Status</span>
        </div>

        <div class="project-card__content">
            <p class="project-card__category">@Category</p>
            <h3>@Title</h3>
            <p class="project-card__description">@Description</p>
        </div>

        <dl class="project-card__details">
            <div>
                <dt>Rôle</dt>
                <dd>@Role</dd>
            </div>
            <div>
                <dt>Preuve vérifiée</dt>
                <dd>@Impact</dd>
            </div>
        </dl>

        <ul class="project-card__stack" aria-label="Technologies et domaines associés">
            @foreach (var item in Stack)
            {
                <li>@item</li>
            }
        </ul>

        <a class="project-card__link" href="@ActionHref">
            @ActionLabel <span aria-hidden="true">→</span>
        </a>
    </div>
</article>

@code {
    [Parameter]
    public string Step { get; set; } = string.Empty;

    [Parameter]
    public string Category { get; set; } = string.Empty;

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string Description { get; set; } = string.Empty;

    [Parameter]
    public string Role { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<string> Stack { get; set; } = Array.Empty<string>();

    [Parameter]
    public string Impact { get; set; } = string.Empty;

    [Parameter]
    public string Status { get; set; } = string.Empty;

    [Parameter]
    public string ActionLabel { get; set; } = string.Empty;

    [Parameter]
    public string ActionHref { get; set; } = "#contact";

    [Parameter]
    public string Tone { get; set; } = "neutral";

    [Parameter]
    public string Preview { get; set; } = "operations";

    [Parameter]
    public bool Featured { get; set; }

    private string CardClass => $"project-card project-card--{Tone}{(Featured ? " project-card--featured" : string.Empty)}";

    private string PreviewLabel => Preview switch
    {
        "frontend" => "Portail de Business Intelligence",
        "data" => "Flux ETL documenté",
        _ => "Pipeline de livraison"
    };
}
