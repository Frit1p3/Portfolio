@using Portfolio.Content

<header id="top" class="site-header">
    <a class="skip-link" href="#main-content">Aller au contenu</a>

    <div class="site-header__inner">
        <a class="site-header__brand" href="./" aria-label="Merryl Bouchereau - Retour à l'accueil">
            <strong>Merryl Bouchereau</strong>
            <span>Applications métier · .NET</span>
        </a>

        <nav id="primary-navigation" class="@NavigationClass" aria-label="Navigation principale">
            @foreach (var link in LandingContent.PrimaryNavigationLinks)
            {
                <a href="@link.Href" @onclick="CloseMenu">@link.Label</a>
            }
            <a class="site-header__nav-contact" href="#contact" @onclick="CloseMenu">Me contacter</a>
        </nav>

        <div class="site-header__action">
            <Button Href="#contact">Me contacter</Button>
        </div>

        <button
            class="site-header__menu"
            type="button"
            aria-label="@MenuLabel"
            aria-controls="primary-navigation"
            aria-expanded="@(isMenuOpen ? "true" : "false")"
            @onclick="ToggleMenu">
            <span>Menu</span>
            <span class="site-header__menu-icon" aria-hidden="true"></span>
        </button>
    </div>
</header>

@code {
    private bool isMenuOpen;

    private string NavigationClass => isMenuOpen
        ? "site-header__nav site-header__nav--open"
        : "site-header__nav";

    private string MenuLabel => isMenuOpen ? "Menu de navigation - Fermer" : "Menu de navigation - Ouvrir";

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private void CloseMenu() => isMenuOpen = false;
}
