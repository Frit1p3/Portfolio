@using Portfolio.Content

@inject IJSRuntime JS

<header id="top" class="site-header" @onkeydown="HandleKeyDown">
    <a class="skip-link" href="#main-content">Aller au contenu</a>

    <div class="site-header__inner">
        <a class="site-header__brand" href="./" aria-label="Merryl Bouchereau - Retour à l'accueil">
            <img src="images/merryl-bouchereau-portrait.jpg" alt="" width="48" height="48" decoding="async" fetchpriority="high" />
            <span class="site-header__brand-copy">
                <strong>Merryl Bouchereau</strong>
                <span>Chef de projet technique · .NET</span>
            </span>
        </a>

        <button
            @ref="menuButton"
            class="site-header__menu"
            type="button"
            aria-label="@MenuLabel"
            aria-controls="primary-navigation"
            aria-expanded="@(isMenuOpen ? "true" : "false")"
            @onclick="ToggleMenu">
            <span>Menu</span>
            <span class="site-header__menu-icon" aria-hidden="true"></span>
        </button>

        <nav id="primary-navigation" class="@NavigationClass" aria-label="Navigation principale">
            @foreach (var link in LandingContent.PrimaryNavigationLinks)
            {
                <a href="@link.Href" @onclick="() => NavigateToAsync(link.Href)" @onclick:preventDefault="true">@link.Label</a>
            }
            <a class="site-header__nav-contact" href="#contact" @onclick='() => NavigateToAsync("#contact")' @onclick:preventDefault="true">Me contacter</a>
        </nav>

        <div class="site-header__action">
            <Button Href="#contact">Me contacter</Button>
        </div>
    </div>
</header>

@code {
    private bool isMenuOpen;
    private ElementReference menuButton;

    private string NavigationClass => isMenuOpen
        ? "site-header__nav site-header__nav--open"
        : "site-header__nav";

    private string MenuLabel => isMenuOpen ? "Menu de navigation - Fermer" : "Menu de navigation - Ouvrir";

    private void ToggleMenu() => isMenuOpen = !isMenuOpen;

    private async Task NavigateToAsync(string target)
    {
        isMenuOpen = false;
        await JS.InvokeVoidAsync("portfolioMotion.navigateToAnchor", target);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (!isMenuOpen || args.Key != "Escape")
        {
            return;
        }

        isMenuOpen = false;
        await menuButton.FocusAsync();
    }
}
