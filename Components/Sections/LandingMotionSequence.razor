@using Portfolio.Content

<section class="motion-sequence" aria-labelledby="motion-sequence-title">
    <div class="motion-sequence__header">
        <div>
            <span class="motion-sequence__eyebrow">Sequence motion</span>
            <h2 id="motion-sequence-title">Ouvrir la demonstration par etats progressifs.</h2>
        </div>

        <div class="motion-sequence__controls" aria-label="Controle de la sequence">
            <button class="motion-sequence__control" type="button" @onclick="SelectPrevious">Precedent</button>
            <button class="motion-sequence__control" type="button" @onclick="SelectNext">Suivant</button>
        </div>
    </div>

    <div class="motion-sequence__stage motion-sequence__stage--@ActiveState.Tone" aria-live="polite">
        <span class="motion-sequence__step">@ActiveState.Step</span>
        <div class="motion-sequence__copy">
            <h3>@ActiveState.Title</h3>
            <p>@ActiveState.Description</p>
        </div>
    </div>

    <div class="motion-sequence__tabs" role="tablist" aria-label="Etats de la sequence motion">
        @foreach (var state in LandingContent.LandingMotionStates)
        {
            <button
                class="@GetTabClassName(state)"
                type="button"
                role="tab"
                aria-selected="@IsActive(state).ToString().ToLowerInvariant()"
                aria-label="@($"{state.Step} - {state.Title}")"
                @onclick="@(() => SelectState(state.Key))">
                <span>@state.Step</span>
                <span>@state.Title</span>
            </button>
        }
    </div>
</section>

@code {
    private string activeStateKey = LandingContent.LandingMotionStates.FirstOrDefault(state => state.IsActive)?.Key
        ?? LandingContent.LandingMotionStates.First().Key;

    private MotionState ActiveState => LandingContent.LandingMotionStates.First(state => state.Key == activeStateKey);

    private int ActiveStateIndex => LandingContent.LandingMotionStates
        .Select((state, index) => new { state.Key, index })
        .First(item => item.Key == activeStateKey)
        .index;

    private void SelectState(string key)
    {
        activeStateKey = key;
    }

    private void SelectPrevious()
    {
        var states = LandingContent.LandingMotionStates;
        var previousIndex = ActiveStateIndex == 0 ? states.Count - 1 : ActiveStateIndex - 1;
        activeStateKey = states[previousIndex].Key;
    }

    private void SelectNext()
    {
        var states = LandingContent.LandingMotionStates;
        var nextIndex = ActiveStateIndex == states.Count - 1 ? 0 : ActiveStateIndex + 1;
        activeStateKey = states[nextIndex].Key;
    }

    private bool IsActive(MotionState state) => state.Key == activeStateKey;

    private string GetTabClassName(MotionState state) => IsActive(state)
        ? $"motion-sequence__tab motion-sequence__tab--{state.Tone} motion-sequence__tab--active"
        : $"motion-sequence__tab motion-sequence__tab--{state.Tone}";
}
