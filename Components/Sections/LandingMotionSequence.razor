@using Portfolio.Content

<section class="motion-sequence" aria-labelledby="motion-sequence-title">
    <div class="motion-sequence__header">
        <div>
            <span class="motion-sequence__eyebrow">Sequence motion</span>
            <h2 id="motion-sequence-title">Ouvrir la demonstration par etats progressifs.</h2>
        </div>

        <div class="motion-sequence__controls" aria-label="Controle de la sequence">
            <button class="motion-sequence__control" type="button" @onclick="SelectPrevious">Precedent</button>
            <button class="motion-sequence__control" type="button" @onclick="SelectNext">Suivant</button>
            <button class="motion-sequence__control" type="button" @onclick="ReplaySequence">Rejouer</button>
        </div>
    </div>

    <div
        id="@PanelId"
        class="motion-sequence__stage motion-sequence__stage--@ActiveState.Tone"
        role="tabpanel"
        aria-labelledby="@ActiveTabId"
        aria-live="polite">
        <span class="motion-sequence__step">@ActiveState.Step</span>
        <div class="motion-sequence__copy">
            <h3>@ActiveState.Title</h3>
            <p>@ActiveState.Description</p>
        </div>
    </div>

    <div class="motion-sequence__tabs" role="tablist" aria-label="Etats de la sequence motion">
        @for (var index = 0; index < LandingContent.LandingMotionStates.Count; index++)
        {
            var tabIndex = index;
            var state = LandingContent.LandingMotionStates[index];

            <button
                class="@GetTabClassName(state)"
                id="@GetTabId(state)"
                @ref="tabReferences[tabIndex]"
                type="button"
                role="tab"
                aria-selected="@IsActive(state).ToString().ToLowerInvariant()"
                aria-controls="@PanelId"
                aria-label="@($"{state.Step} - {state.Title}")"
                tabindex="@(IsActive(state) ? "0" : "-1")"
                @onkeydown="@((keyboardEvent) => HandleTabKeyDown(keyboardEvent, state.Key))"
                @onclick="@(() => SelectState(state.Key))">
                <span>@state.Step</span>
                <span>@state.Title</span>
            </button>
        }
    </div>
</section>

@code {
    private readonly ElementReference[] tabReferences = new ElementReference[LandingContent.LandingMotionStates.Count];
    private int? pendingFocusIndex;

    private string activeStateKey = LandingContent.LandingMotionStates.FirstOrDefault(state => state.IsActive)?.Key
        ?? LandingContent.LandingMotionStates.First().Key;

    private MotionState ActiveState => LandingContent.LandingMotionStates.First(state => state.Key == activeStateKey);

    private string ActiveTabId => GetTabId(ActiveState);

    private const string PanelId = "motion-sequence-panel";

    private void SelectState(string key)
    {
        activeStateKey = key;
    }

    private void SelectFirst(bool shouldFocus = false)
    {
        SelectIndex(0, shouldFocus);
    }

    private void SelectLast(bool shouldFocus = false)
    {
        SelectIndex(LandingContent.LandingMotionStates.Count - 1, shouldFocus);
    }

    private void SelectPrevious()
    {
        SelectPreviousFrom(activeStateKey);
    }

    private void SelectNext()
    {
        SelectNextFrom(activeStateKey);
    }

    private void ReplaySequence()
    {
        SelectFirst(true);
    }

    private void SelectPreviousFrom(string key, bool shouldFocus = false)
    {
        var states = LandingContent.LandingMotionStates;
        var currentIndex = GetStateIndex(key);
        var previousIndex = currentIndex == 0 ? states.Count - 1 : currentIndex - 1;
        SelectIndex(previousIndex, shouldFocus);
    }

    private void SelectNextFrom(string key, bool shouldFocus = false)
    {
        var states = LandingContent.LandingMotionStates;
        var currentIndex = GetStateIndex(key);
        var nextIndex = currentIndex == states.Count - 1 ? 0 : currentIndex + 1;
        SelectIndex(nextIndex, shouldFocus);
    }

    private void HandleTabKeyDown(KeyboardEventArgs keyboardEvent, string stateKey)
    {
        switch (keyboardEvent.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                SelectNextFrom(stateKey, true);
                break;
            case "ArrowLeft":
            case "ArrowUp":
                SelectPreviousFrom(stateKey, true);
                break;
            case "Home":
                SelectFirst(true);
                break;
            case "End":
                SelectLast(true);
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocusIndex is not { } focusIndex)
        {
            return;
        }

        pendingFocusIndex = null;
        await tabReferences[focusIndex].FocusAsync();
    }

    private void SelectIndex(int index, bool shouldFocus = false)
    {
        activeStateKey = LandingContent.LandingMotionStates[index].Key;

        if (shouldFocus)
        {
            pendingFocusIndex = index;
        }
    }

    private static int GetStateIndex(string key) => LandingContent.LandingMotionStates
        .Select((state, index) => new { state.Key, index })
        .First(item => item.Key == key)
        .index;

    private bool IsActive(MotionState state) => state.Key == activeStateKey;

    private static string GetTabId(MotionState state) => $"motion-sequence-tab-{state.Key}";

    private string GetTabClassName(MotionState state) => IsActive(state)
        ? $"motion-sequence__tab motion-sequence__tab--{state.Tone} motion-sequence__tab--active"
        : $"motion-sequence__tab motion-sequence__tab--{state.Tone}";
}
