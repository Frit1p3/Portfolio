@using Portfolio.Content
@implements IDisposable
@inject IJSRuntime JSRuntime

<section class="motion-sequence" aria-labelledby="motion-sequence-title">
    <div class="motion-sequence__header">
        <div>
            <span class="motion-sequence__eyebrow">Séquence motion</span>
            <h2 id="motion-sequence-title">Ouvrir la démonstration par états progressifs.</h2>
        </div>

        <LandingMotionControls
            IsAutoPlaying="@isAutoPlaying"
            IsAutoPlayDisabled="@prefersReducedMotion"
            OnPrevious="SelectPrevious"
            OnNext="SelectNext"
            OnReplay="ReplaySequence"
            OnAutoPlayToggle="ToggleAutoPlay" />
    </div>

    <LandingMotionStage
        State="@ActiveState"
        PanelId="@PanelId"
        ActiveTabId="@ActiveTabId" />

    <LandingMotionTabs
        @ref="motionTabs"
        States="@LandingContent.LandingMotionStates"
        ActiveStateKey="@activeStateKey"
        PanelId="@PanelId"
        OnSelected="SelectState"
        OnKeyDown="HandleTabKeyDown" />
</section>

@code {
    private LandingMotionTabs? motionTabs;
    private int? pendingFocusIndex;
    private CancellationTokenSource? autoPlayCancellation;
    private bool isAutoPlaying;
    private bool prefersReducedMotion;

    private string activeStateKey = LandingContent.LandingMotionStates.FirstOrDefault(state => state.IsActive)?.Key
        ?? LandingContent.LandingMotionStates.First().Key;

    private MotionState ActiveState => LandingContent.LandingMotionStates.First(state => state.Key == activeStateKey);

    private string ActiveTabId => LandingMotionTabs.GetTabId(ActiveState);

    private const string PanelId = "motion-sequence-panel";
    private const int AutoPlayDelayInMilliseconds = 4200;

    private void SelectState(string key)
    {
        StopAutoPlayForManualInteraction();
        activeStateKey = key;
    }

    private void SelectFirst(bool shouldFocus = false)
    {
        SelectIndex(0, shouldFocus);
    }

    private void SelectLast(bool shouldFocus = false)
    {
        SelectIndex(LandingContent.LandingMotionStates.Count - 1, shouldFocus);
    }

    private void SelectPrevious()
    {
        StopAutoPlayForManualInteraction();
        SelectPreviousFrom(activeStateKey);
    }

    private void SelectNext()
    {
        StopAutoPlayForManualInteraction();
        SelectNextFrom(activeStateKey);
    }

    private void ReplaySequence()
    {
        StopAutoPlayForManualInteraction();
        SelectFirst(true);
    }

    private void ToggleAutoPlay()
    {
        if (prefersReducedMotion)
        {
            StopAutoPlay();
            return;
        }

        if (isAutoPlaying)
        {
            StopAutoPlay();
            return;
        }

        StartAutoPlay();
    }

    private void StartAutoPlay()
    {
        if (prefersReducedMotion)
        {
            StopAutoPlay();
            return;
        }

        StopAutoPlay();

        isAutoPlaying = true;
        autoPlayCancellation = new CancellationTokenSource();
        _ = RunAutoPlayAsync(autoPlayCancellation.Token);
    }

    private void StopAutoPlay()
    {
        if (autoPlayCancellation is null)
        {
            isAutoPlaying = false;
            return;
        }

        autoPlayCancellation.Cancel();
        autoPlayCancellation.Dispose();
        autoPlayCancellation = null;
        isAutoPlaying = false;
    }

    private void StopAutoPlayForManualInteraction()
    {
        if (isAutoPlaying)
        {
            StopAutoPlay();
        }
    }

    private void SelectPreviousFrom(string key, bool shouldFocus = false)
    {
        var states = LandingContent.LandingMotionStates;
        var currentIndex = GetStateIndex(key);
        var previousIndex = currentIndex == 0 ? states.Count - 1 : currentIndex - 1;
        SelectIndex(previousIndex, shouldFocus);
    }

    private void SelectNextFrom(string key, bool shouldFocus = false)
    {
        var states = LandingContent.LandingMotionStates;
        var currentIndex = GetStateIndex(key);
        var nextIndex = currentIndex == states.Count - 1 ? 0 : currentIndex + 1;
        SelectIndex(nextIndex, shouldFocus);
    }

    private void HandleTabKeyDown(MotionTabKeyDown keyDown)
    {
        switch (keyDown.KeyboardEvent.Key)
        {
            case "ArrowRight":
            case "ArrowDown":
                StopAutoPlayForManualInteraction();
                SelectNextFrom(keyDown.StateKey, true);
                break;
            case "ArrowLeft":
            case "ArrowUp":
                StopAutoPlayForManualInteraction();
                SelectPreviousFrom(keyDown.StateKey, true);
                break;
            case "Home":
                StopAutoPlayForManualInteraction();
                SelectFirst(true);
                break;
            case "End":
                StopAutoPlayForManualInteraction();
                SelectLast(true);
                break;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            prefersReducedMotion = await JSRuntime.InvokeAsync<bool>("portfolioMotion.prefersReducedMotion");

            if (prefersReducedMotion)
            {
                StopAutoPlay();
            }

            StateHasChanged();
        }

        if (pendingFocusIndex is not { } focusIndex)
        {
            return;
        }

        pendingFocusIndex = null;
        if (motionTabs is not null)
        {
            await motionTabs.FocusTabAsync(focusIndex);
        }
    }

    private async Task RunAutoPlayAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(AutoPlayDelayInMilliseconds, cancellationToken);
                await InvokeAsync(() =>
                {
                    SelectNextFrom(activeStateKey);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void SelectIndex(int index, bool shouldFocus = false)
    {
        activeStateKey = LandingContent.LandingMotionStates[index].Key;

        if (shouldFocus)
        {
            pendingFocusIndex = index;
        }
    }

    private static int GetStateIndex(string key) => LandingContent.LandingMotionStates
        .Select((state, index) => new { state.Key, index })
        .First(item => item.Key == key)
        .index;

    public void Dispose()
    {
        StopAutoPlay();
    }
}
