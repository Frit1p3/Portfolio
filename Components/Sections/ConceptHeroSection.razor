@using Portfolio.Content

<section class="concept-hero" aria-labelledby="concept-hero-title">
    <div class="concept-hero__inner">
        <div class="concept-hero__lead">
            <div class="concept-hero__content">
                <Badge Tone="accent">@LandingContent.HeroEyebrow</Badge>

                <h1 id="concept-hero-title">@LandingContent.HeroTitle</h1>

                <p>@LandingContent.HeroIntro</p>

                <div class="concept-hero__actions" aria-label="Actions principales">
                    <Button Href="#projects">Voir mes projets</Button>
                    <Button Href="#case-study" Variant="secondary">Lire l'étude de cas</Button>
                </div>

                <ul class="concept-hero__credentials" aria-label="Spécialités principales">
                    <li>UX métier</li>
                    <li>Blazor &amp; .NET</li>
                    <li>Data &amp; KPI</li>
                </ul>
            </div>

            <article class="concept-hero__dashboard" aria-label="Aperçu d'un tableau de pilotage atelier">
                <header class="concept-hero__dashboard-header">
                    <div>
                        <span>Vue opérations</span>
                        <strong>Pilotage atelier</strong>
                    </div>
                    <span class="concept-hero__status"><i aria-hidden="true"></i>Données synchronisées</span>
                </header>

                <div class="concept-hero__dashboard-main">
                    <div class="concept-hero__primary-metric">
                        <span>Rendement atelier</span>
                        <strong>87%</strong>
                        <small>+6 pts cette semaine</small>
                    </div>

                    <div class="concept-hero__signal-list" aria-label="Signaux opérationnels">
                        <div>
                            <span>Alertes critiques</span>
                            <strong>12</strong>
                            <small>3 à traiter en priorité</small>
                        </div>
                        <div>
                            <span>Cycle moyen</span>
                            <strong>2,8 j</strong>
                            <small>Objectif : 3 jours</small>
                        </div>
                    </div>
                </div>

                <footer class="concept-hero__dashboard-footer">
                    <span>Sources connectées</span>
                    <ul>
                        @foreach (var source in LandingContent.ConceptSources.Take(3))
                        {
                            <li><i class="concept-hero__source-dot concept-hero__source-dot--@source.Tone" aria-hidden="true"></i>@source.Label</li>
                        }
                    </ul>
                </footer>
            </article>
        </div>

    </div>
</section>
