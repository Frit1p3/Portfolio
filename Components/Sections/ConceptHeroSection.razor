@using Portfolio.Content

<section class="concept-hero" aria-labelledby="concept-hero-title">
    <div class="concept-hero__inner">
        <div class="concept-hero__content">
            <span class="concept-hero__eyebrow"><i aria-hidden="true"></i>Portfolio professionnel</span>
            <h1 id="concept-hero-title">@LandingContent.HeroTitle</h1>
            <p>@LandingContent.HeroIntro</p>
        </div>

        <nav class="concept-hero__index" aria-label="Explorer le portfolio">
            @foreach (var item in LandingContent.HeroIndexItems)
            {
                <a href="@item.Href">
                    <span class="concept-hero__index-number">@item.Number</span>
                    <span class="concept-hero__index-copy">
                        <strong>@item.Label</strong>
                        <small>@item.Description</small>
                    </span>
                    <span class="concept-hero__index-arrow" aria-hidden="true">→</span>
                </a>
            }
        </nav>

        <footer class="concept-hero__footer">
            <span>Domaines d'intervention</span>
            <strong>Pilotage <i>·</i> .NET <i>·</i> Data</strong>
        </footer>
    </div>
</section>
