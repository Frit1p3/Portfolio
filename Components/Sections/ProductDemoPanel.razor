@using Portfolio.Content

<section id="@Id" class="product-demo-panel" aria-label="@AriaLabel">
    <div class="product-demo-panel__header">
        <span>@Title</span>
        <Badge Tone="neutral">Demo</Badge>
    </div>

    <div class="product-demo-panel__sources" aria-label="Sources connectées">
        @foreach (var source in LandingContent.ProductSources)
        {
            <SourceCompactCard
                Label="@source.Label"
                Type="@source.Type"
                Description="@source.Description"
                Status="@source.Status"
                Tone="@source.Tone" />
        }
    </div>

    <div class="product-demo-panel__decisions" aria-label="Lecture décisionnelle">
        @foreach (var metric in LandingContent.ProductDecisionMetrics)
        {
            <DecisionTimelineCard
                Step="@metric.Step"
                Meta="@metric.Meta"
                Title="@metric.Title"
                Description="@metric.Description"
                Tone="@metric.Tone" />
        }
    </div>
</section>

@code {
    [Parameter]
    public string Id { get; set; } = "proof";

    [Parameter]
    public string Title { get; set; } = LandingContent.ProductDemoTitle;

    private string AriaLabel => $"Aperçu de démonstration produit - {Title}";
}
