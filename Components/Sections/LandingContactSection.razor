@using Portfolio.Content

<section class="contact-section" id="contact" data-reveal aria-labelledby="contact-guidance-title">
    <div class="contact-section__inner">
        <div class="contact-section__layout">
            <aside class="contact-section__guidance" aria-labelledby="contact-guidance-title">
                <div class="contact-section__guidance-heading">
                    <h2 id="contact-guidance-title">@LandingContent.ContactGuidanceTitle</h2>
                    <p>@LandingContent.ContactGuidanceBody</p>
                </div>

                <div class="contact-section__highlights" aria-label="Sujets de mission prioritaires">
                    @foreach (var highlight in LandingContent.ContactHighlights)
                    {
                        <article class="contact-section__highlight contact-section__highlight--@highlight.Tone" aria-label="@highlight.Title">
                            <h3>@highlight.Title</h3>
                            <p>@highlight.Description</p>
                        </article>
                    }
                </div>

                <a class="contact-section__email" href="@($"mailto:{LandingContent.ContactEmail}")">
                    Écrire directement à @LandingContent.ContactEmail
                </a>

                <nav class="contact-section__resources" aria-label="Profil professionnel et CV">
                    <a href="@LandingContent.LinkedInUrl" target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
                    <a href="@LandingContent.GitHubUrl" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
                    <a href="@LandingContent.CvRequestUrl">Demander le CV <span aria-hidden="true">→</span></a>
                </nav>
            </aside>

            <ContactForm />
        </div>
    </div>
</section>
