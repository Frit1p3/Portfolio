@using Portfolio.Content

<section class="projects-section" id="projects" aria-labelledby="projects-section-title">
    <SectionHeader
        Eyebrow="@LandingContent.ProjectsEyebrow"
        Title="@LandingContent.ProjectsTitle"
        TitleId="projects-section-title"
        Description="@LandingContent.ProjectsIntro" />

    <div class="projects-section__grid" aria-label="Cas d'usage representatifs">
        @foreach (var project in LandingContent.ProjectUseCases)
        {
            <article class="projects-section__card projects-section__card--@project.Tone" aria-label="@($"{project.Step} - {project.Title}")">
                <div class="projects-section__card-header">
                    <span class="projects-section__index">@project.Step</span>
                    <span class="projects-section__meta">@project.Meta</span>
                </div>
                <h3>@project.Title</h3>
                <p>@project.Description</p>
            </article>
        }
    </div>
</section>
