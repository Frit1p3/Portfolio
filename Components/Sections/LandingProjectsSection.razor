@using Portfolio.Content

<section class="projects-section" id="projects" data-reveal aria-labelledby="projects-section-title">
    <SectionHeader
        Eyebrow="@LandingContent.ProjectsEyebrow"
        Title="@LandingContent.ProjectsTitle"
        TitleId="projects-section-title"
        Description="@LandingContent.ProjectsIntro" />

    <p class="projects-section__result">
        3 études de cas complémentaires · produit, data et delivery
    </p>

    <div class="projects-section__grid" aria-label="Cas d'usage representatifs">
        @foreach (var project in LandingContent.ProjectUseCases)
        {
            <ProjectCard
                Step="@project.Step"
                Category="@project.Category"
                Preview="@project.CategoryKey"
                Featured="@(project.Step == "01")"
                Title="@project.Title"
                Description="@project.Description"
                Role="@project.Role"
                Stack="@project.Stack"
                Impact="@project.Impact"
                Status="@project.Status"
                ActionLabel="@project.ActionLabel"
                ActionHref="@project.ActionHref"
                Tone="@project.Tone" />
        }
    </div>
</section>
