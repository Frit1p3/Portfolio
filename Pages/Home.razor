@page "/"

<PageTitle>Merryl - Front-End .NET industriel</PageTitle>

<section class="hero-shell" aria-labelledby="home-title">
    <div class="hero-shell__content">
        <Badge Tone="accent">Portfolio applicatif</Badge>

        <h1 id="home-title">Interfaces metier industrielles, lisibles et orientees decision.</h1>

        <p>
            Developpeur Front-End .NET specialise dans les experiences B2B, les dashboards KPI
            et les design systems pour environnements industriels.
        </p>

        <div class="hero-shell__actions" aria-label="Actions principales">
            <Button Href="#proof">Voir la demonstration</Button>
            <Button Href="#contact" Variant="secondary">Me contacter</Button>
        </div>
    </div>

    <div class="hero-proof" id="proof" aria-label="Apercu de demonstration produit">
        <div class="hero-proof__header">
            <span>Cartographie des flux metier</span>
            <Badge Tone="neutral">Demo</Badge>
        </div>
        <div class="hero-proof__grid">
            <article>
                <strong>ERP</strong>
                <span>Commandes et stocks</span>
            </article>
            <article>
                <strong>Atelier</strong>
                <span>Incidents et qualite</span>
            </article>
            <article>
                <strong>BI</strong>
                <span>KPI et tendances</span>
            </article>
        </div>
        <div class="hero-proof__decision">
            <span>Lecture decisionnelle</span>
            <strong>3 priorites actionnables</strong>
        </div>
    </div>
</section>

<section class="section-band" aria-labelledby="principles-title">
    <div class="section-heading">
        <span class="section-heading__eyebrow">Socle</span>
        <h2 id="principles-title">Une base faite pour desktop et mobile.</h2>
        <p>
            Cette premiere version pose le routing, le layout, les tokens CSS et les premiers
            composants reutilisables avant la transposition de la landing Figma.
        </p>
    </div>
</section>
